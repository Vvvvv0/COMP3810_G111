<%- include('../home/index') %>

<% if (errors && errors.length > 0) { %>
    <div class="error">
        <ul>
        <% errors.forEach(function(message) { %>
            <li><%= message %></li>
        <% }); %>
        </ul>
    </div>
<% } %>
<% if (success) { %>
    <div class="success"><%= success %></div>
<% } %> 
<div class = "form-container">
    <form action="/profile" method="POST">
        <h3>My Profile</h3>
        <div class="form-group">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" value="<%= profile.username %>" readonly>    
        </div>
        <h3>Email</h3>
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= profile.email %>">
        </div>
        <h3>Display Name</h3>
        <div class="form-group">
            <label for="displayName">Display Name</label>
            <input type="text" id="displayName" name="displayName" value="<%= profile.displayName %>">
        </div>
        <h3>Change Password</h3>
        <div class="form-group">
            <label for="currentPassword">Current Password</label>
            <input type="password" id="currentPassword" name="currentPassword">
        </div>
        <h3>New Password</h3>
        <div class="form-group">
            <label for="newPassword">New Password</label>
            <input type="password" id="newPassword" name="newPassword">
        </div>
        <p class="hint">At least 8 characters, including uppercase, lowercase, number, and special character.</p>
        <h3>Confirm New Password</h3>
        <div class="form-group">
            <label for="confirmNewPassword">Confirm New Password</label>
            <input type="password" id="confirmNewPassword" name="confirmNewPassword" >
        </div>
        <button type="submit">Update Profile</button>
    </form>

</div>
<%- include('../home/footer') %>