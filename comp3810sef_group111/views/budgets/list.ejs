<%- include('../home/index') %>
<div class="form-container">
  <h2>Budgets</h2>

  <form method="GET" action="/budgets" class="form-group">
    <label for="month">Month</label>
    <input type="month" id="month" name="month" value="<%= month %>">
    <button type="submit">Filter</button>
    <a href="/budgets/new">+ Add Budget</a>
    <a href="/budgets/dashboard?month=<%= month %>">Dashboard</a>
  </form>

  <% if (error) { %>
  <div class="error"><%= error %></div>
  <% } %>

  <table>
    <thead>
      <tr>
        <th>Category</th>
        <th>Budget</th>
        <th>Spent</th>
        <th>Remaining</th>
        <th>Usage</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% budgets.forEach(function (bg) { %>
      <tr>
        <td><%= bg.category || 'Overall' %></td>
        <td><%= bg.amount %></td>
        <td><%= bg.spentAmount %></td>
        <td><%= bg.remaining %></td>
        <td>
          <%= bg.usagePct %>%
          <% if (bg.warning) { %><span class="error"> (80%+)</span><% } %>
        </td>
        <td>
          <a href="/budgets/<%= bg._id %>/edit">Edit</a>
          <form method="POST" action="/budgets/<%= bg._id %>/delete" style="display:inline">
            <button type="submit">Delete</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<%- include('../home/footer') %>
