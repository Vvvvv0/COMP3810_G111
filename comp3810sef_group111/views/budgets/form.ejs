<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= budget ? "Edit Budget" : "Add New Budget" %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1><%= budget ? "Edit Budget" : "Create New Budget" %></h1>

    <form method="POST">
        <label>Category:</label>
        <input type="text" name="category" value="<%= budget ? budget.category : '' %>" required>
        <br><br>

        <label>Budget Amount:</label>
        <input type="number" step="0.01" name="amount" value="<%= budget ? budget.amount : '' %>" required>
        <br><br>

        <label>Month:</label>
        <input type="month" name="month" value="<%= budget ? budget.month : '' %>" required>
        <br><br>

        <button type="submit">Save</button>
    </form>

    <br>
    <a href=" ">← Back to Budget List</a >
</body>
</html>