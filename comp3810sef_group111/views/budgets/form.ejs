<%- include('../home/index') %>
<div class="form-container">
  <h2><%= editing ? 'Edit Budget' : 'Add Budget' %></h2>

  <% if (errors) { %>
  <div class="error"><%= errors %></div>
  <% } %>

  <form
    method="POST"
    action="<%= editing ? `/budgets/${values._id}/update` : '/budgets' %>"
  >
    <div class="form-group">
      <label for="month">Month</label>
      <input type="month" id="month" name="month" value="<%= values.month %>" required>
    </div>

    <div class="form-group">
      <label for="category">Category (leave blank for overall budget)</label>
      <input
        type="text"
        id="category"
        name="category"
        value="<%= values.category || '' %>"
        placeholder="e.g. Food, Transport"
      >
    </div>

    <div class="form-group">
      <label for="amount">Budget amount</label>
      <input
        type="number"
        id="amount"
        name="amount"
        step="0.01"
        min="0.01"
        value="<%= values.amount %>"
        required
      >
    </div>

    <button type="submit"><%= editing ? 'Save Changes' : 'Create Budget' %></button>
    <a href="/budgets">Cancel</a>
  </form>
</div>
<%- include('../home/footer') %>
