<%- include('../home/index') %>



<main class="goals-page">

  <h2>My Saving Goals</h2>



  <% if (message) { %>

    <div class="success"><%= message %></div>

  <% } %>

  <% if (errors.length > 0) { %>

    <div class="error">

      <ul>

        <% errors.forEach(function (m) { %>

          <li><%= m %></li>

        <% }); %>

      </ul>

    </div>

  <% } %>



  <div class="goal-summary">

    <div><strong><%= totalCount %></strong><span>Goals</span></div>

    <div class="<%= summary.net < 0 ? 'neg' : '' %>"><strong><%= summary.net.toFixed(2) %></strong><span>Net</span></div>

    <div><strong><%= summary.stillToSave.toFixed(2) %></strong><span>Still to save (target &minus; saved)</span></div>

  </div>



  <% if (totalCount > 0) { %>

  <form method="GET" action="/goals" class="search-box">

    <input type="text" name="keyword" value="<%= filters.keyword %>" placeholder="Search by goal name, e.g. trip" maxlength="50" autocomplete="off">

    <br><br>

    <select name="status">

      <option value="" <%= filters.status === '' ? 'selected' : '' %>>All statuses</option>

      <% ['In progress', 'Completed', 'Overdue'].forEach(function (s) { %>

        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>

      <% }); %>

    </select>

    <button type="submit">Search</button>

    <a href="/goals">Clear</a>

  </form>

  <% } %>



  <p><a class="btn" href="/goals/new">+ Add goal</a></p>



  <% if (totalCount === 0) { %>

    <p class="hint">No saving goals yet. Click "+ Add goal" to create your first one.</p>

  <% } else if (goals.length === 0) { %>

    <p class="hint">No goals match your search. <a href="/goals">Show all goals</a></p>

  <% } else { %>

  <div class="table-wrap">

    <table>

      <thead>

        <tr>

          <th>Goal</th>

          <th>Progress</th>

          <th>Saved</th>

          <th>Target</th>

          <th>Remaining</th>

          <th>Deadline</th>

          <th>Status</th>

          <th>Actions</th>

        </tr>

      </thead>

      <tbody>

        <% goals.forEach(function (g) {

             var cls = g.statusLabel.toLowerCase().replace(" ", "-"); %>

        <tr>

          <td><span class="goal-name"><%= g.name %></span></td>

          <td>

            <div class="bar"><div class="bar-fill <%= cls %>" style="width: <%= g.percent %>%"></div></div>

            <span class="pct"><%= g.percent %>%</span>

          </td>

          <td><%= g.savedAmount.toFixed(2) %></td>

          <td><%= g.targetAmount.toFixed(2) %></td>

          <td><%= g.remaining.toFixed(2) %></td>

          <td><%= g.deadline ? g.deadline : "None" %></td>

          <td><span class="badge <%= cls %>"><%= g.statusLabel %></span></td>

          <td class="actions">

            <% if (g.statusLabel !== "Completed" && summary.net > 0) { %>

            <form class="inline-form" action="/goals/<%= g._id %>/save" method="POST">

              <input type="number" name="amount" min="0.01" max="<%= summary.net.toFixed(2) %>" step="0.01" placeholder="Saving" required>

              <button type="submit">Add</button>

            </form>

            <% } else if (g.statusLabel !== "Completed") { %>

            <span class="hint">Blocked: no net balance</span>

            <% } %>

            <a href="/goals/<%= g._id %>/edit">Edit</a>

            <form class="inline-form" action="/goals/<%= g._id %>/delete" method="POST">

              <button type="submit" class="danger">Delete</button>

            </form>

          </td>

        </tr>

        <% }); %>

      </tbody>

    </table>

  </div>

  <% } %>

</main>

</BODY>

</HTML>
