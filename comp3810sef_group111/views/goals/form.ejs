<%- include('../home/index') %>
<%
  // The route normally supplies these; the defaults let the page open on its own.
  var f = locals.values || { name: "", targetAmount: "", deadline: "" };
  var errors = locals.errors || [];
  var heading = locals.heading || "Add Saving Goal";
  var action = locals.action || "/goals";
  var submitLabel = locals.submitLabel || "Save";
%>
<div class="form-container">
  <h2><%= heading %></h2>

  <% if (errors.length > 0) { %>
  <div class="error">
    <ul>
    <% errors.forEach(function (m) { %>
      <li><%= m %></li>
    <% }); %>
    </ul>
  </div>
  <% } %>

  <form action="<%= action %>" method="POST">
    <div class="form-group">
      <label for="name">Goal name</label>
      <input type="text" id="name" name="name" maxlength="50" value="<%= f.name %>" required>
    </div>
    <div class="form-group">
      <label for="targetAmount">Target amount</label>
      <input type="number" id="targetAmount" name="targetAmount" min="0.01" step="0.01" value="<%= f.targetAmount %>" required>
    </div>
    <div class="form-group">
      <label for="deadline">Deadline (optional)</label>
      <input type="date" id="deadline" name="deadline" value="<%= f.deadline %>">
    </div>
    <button type="submit"><%= submitLabel %></button>
  </form>
  <p class="form-footer"><a href="/goals">Back to my goals</a></p>
</div>
<%- include('../home/footer') %>

